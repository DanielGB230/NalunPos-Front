{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@nalunpos/shared/auth": ["./libs/shared/auth/src/index.ts"],
      "@nalunpos/shared/data-access": ["./libs/shared/data-access/src/index.ts"],
      "@nalunpos/shared/ui": ["./libs/shared/ui/src/index.ts"],
      "@nalunpos/shared/design-tokens": ["./libs/shared/design-tokens/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
